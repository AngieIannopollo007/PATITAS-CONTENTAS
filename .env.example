# Copiar como .env. No subir .env a GitHub.
PORT=3000
# Producción: NODE_ENV=production y APP_ORIGIN=https://tu-dominio
# HOST=0.0.0.0 y el puerto del proveedor en despliegues detrás de un proxy.
# TRUST_PROXY=1 solo cuando el proxy de confianza es el único ingreso y agrega la IP del cliente.
# PostgreSQL local. Usá la contraseña del rol patitas_app entre comillas.
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=patitas
PGUSER=patitas_app
PGPASSWORD=
# En el alojamiento podés usar DATABASE_URL con la conexión provista por PostgreSQL.
# Gmail funciona cuando se completa GMAIL_APP_PASSWORD.
GMAIL_USER=
GMAIL_APP_PASSWORD=
# DEMO=1 crea cuentas y mascotas ficticias al iniciar una base vacía.
DEMO=1
